---
import { SITE, STATS, CONTACT_FACTS } from '../data/site';
const links = [
  ['LinkedIn', 'in/cyber-farhan-hussain', SITE.linkedin],
  ['GitHub', '@thecyberfarhan', SITE.github],
  ['TryHackMe', 'farhan.hussain', SITE.tryhackme],
  ['Writeups', `${STATS.writeups} on this site`, '/writeups/'],
  ['Résumé', 'PDF, one page', SITE.resume],
];
const year = new Date().getFullYear();
---
<footer class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="label">Contact</p>
    <h2 id="contact-title">Open to roles in offensive security, <em>and the field around it.</em></h2>
    <div class="mail-row">
      <a class="mail" data-scout="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <button class="copy" type="button" data-copy={SITE.email}>Copy email</button>
    </div>
    <div class="grid">
      <dl class="facts">
        {CONTACT_FACTS.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <ul class="links" data-scout="links">
        {links.map(([name, hint, href]) => (
          <li><a href={href} {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}><span class="n">{name}</span><span class="h">{hint}</span><span class="a" aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
    <div class="fine"><span>© {year} {SITE.name} · Penetration tester</span><span>Built by hand with Astro and anime.js · <a href="/old/">See the old design</a></span></div>
  </div>
</footer>

<style>
  .contact { background: var(--deep); color: var(--on-dark); padding: clamp(90px, 12vw, 140px) 0 44px; }
  .contact .label { color: var(--on-dark-muted); }
  h2 { margin-top: 18px; max-width: 18ch; }
  h2 em { color: var(--hi); }
  .mail-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin: 44px 0 70px; }
  .mail { font: 400 clamp(1.4rem, 3vw, 2.3rem) var(--serif); letter-spacing: -0.015em; text-underline-offset: 7px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .mail:hover { color: var(--hi); }
  .copy { padding: 9px 16px; border-radius: 999px; border: 1px solid #ffffff40; font-size: 13.5px; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .copy:hover { border-color: var(--on-dark); }
  .copy.done { background: var(--on-dark); color: var(--deep); }
  .grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 50px; }
  .facts div { padding: 14px 0; border-bottom: 1px solid #ffffff1f; }
  .facts dd { margin-top: 4px; font-size: 16px; }
  .links { list-style: none; border-top: 1px solid #ffffff1f; }
  .links a { display: grid; grid-template-columns: 1fr auto 24px; gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid #ffffff1f; text-decoration: none; }
  .links .n { font: 400 1.35rem var(--serif); }
  .links .h { font: 500 12.5px var(--mono); color: var(--on-dark-muted); }
  .links .a { transition: transform 0.3s var(--ease-out); color: var(--on-dark-muted); }
  .links a:hover .n { color: var(--hi); }
  .links a:hover .a { transform: translateX(4px); color: var(--on-dark); }
  .fine a { color: inherit; text-underline-offset: 3px; }
  .fine a:hover { color: var(--on-dark); }
  .fine { margin-top: 90px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 13px; color: var(--on-dark-muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 30px; } .links .h { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(b.dataset.copy!);
      b.textContent = 'Copied';
      b.classList.add('done');
      setTimeout(() => { b.textContent = 'Copy email'; b.classList.remove('done'); }, 1800);
    } catch { /* clipboard blocked: the mailto link still works */ }
  }));
</script>
