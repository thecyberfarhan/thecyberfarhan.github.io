---
import { SITE } from '../data/site';
const links = [
  ['How I work', '/#engage'],
  ['Record', '/#record'],
  ['Projects', '/#projects'],
  ['Toolkit', '/#toolkit'],
  ['Writeups', '/writeups/'],
  ['Lab', '/lab/'],
  ['Contact', '/#contact'],
];
---
<header class="nav" id="nav">
  <a class="brand" href="/" aria-label="Farhan Hussain, home">Farhan Hussain<i>.</i></a>
  <nav class="links" aria-label="Main">
    {links.map(([label, href]) => <a href={href} data-spy={href.startsWith('/#') ? href.slice(2) : undefined}>{label}</a>)}
  </nav>
  <div class="end">
    <button class="theme" id="theme-btn" type="button" aria-label="Switch to dark theme" title="Switch theme">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <mask id="moon-cut"><rect width="24" height="24" fill="#fff" /><circle class="cut" cx="24" cy="4" r="7" fill="#000" /></mask>
        <circle class="core" cx="12" cy="12" r="5" mask="url(#moon-cut)" />
        <g class="rays"><path d="M12 1.5v2.2M12 20.3v2.2M1.5 12h2.2M20.3 12h2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></g>
      </svg>
    </button>
    <a class="btn sm line resume" href={SITE.resume}>Résumé</a>
    <button class="menu" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Open menu"><span></span><span></span></button>
  </div>
</header>
<div class="sheet" id="menu" hidden>
  <nav aria-label="Mobile">
    {links.map(([label, href], i) => <a href={href}><span class="label">{String(i + 1).padStart(2, '0')}</span>{label}</a>)}
    <a href={SITE.resume}><span class="label">PDF</span>Résumé</a>
  </nav>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 14px var(--gutter);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent; transition: border-color 0.3s;
  }
  .nav.scrolled { border-color: var(--rule); }
  .brand { font: 600 19px var(--serif); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
  .brand i { color: var(--accent); font-style: normal; }
  .links { display: flex; gap: clamp(16px, 2.2vw, 30px); font-size: 14px; color: var(--soft); }
  .links a { text-decoration: none; transition: color 0.2s; position: relative; }
  .links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease-out); }
  .links a:hover { color: var(--ink); }
  .links a:hover::after { transform: scaleX(1); }
  .links a.on { color: var(--ink); }
  .links a.on::after { transform: scaleX(1); }
  .theme { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--rule-strong); display: grid; place-items: center; color: var(--ink); transition: border-color 0.25s, transform 0.5s var(--ease-out); }
  .theme:hover { border-color: var(--ink); transform: rotate(-12deg); }
  .theme svg { width: 20px; height: 20px; overflow: visible; }
  .theme .core { fill: currentColor; transition: r 0.5s var(--ease-out); }
  .theme .cut { transition: cx 0.5s var(--ease-out), cy 0.5s var(--ease-out); }
  .theme .rays { stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; transform-origin: 12px 12px; transition: transform 0.5s var(--ease-out), opacity 0.3s; }
  :global([data-theme='dark']) .theme .core { r: 8; }
  :global([data-theme='dark']) .theme .cut { cx: 17; cy: 7; }
  :global([data-theme='dark']) .theme .rays { transform: rotate(45deg) scale(0.4); opacity: 0; }
  :global(::view-transition-old(root)), :global(::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
  .end { display: flex; align-items: center; gap: 10px; }
  .menu { display: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--ink); position: relative; }
  .menu span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: var(--ink); transition: transform 0.3s var(--ease-out); }
  .menu span:first-child { top: 16px; }
  .menu span:last-child { top: 24px; }
  .menu[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .menu[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .sheet { position: fixed; inset: 0; z-index: 45; background: var(--paper); padding: 90px var(--gutter) 30px; overflow-y: auto; }
  .sheet nav { display: flex; flex-direction: column; }
  .sheet a { display: flex; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rule); font: 400 1.9rem/1.1 var(--serif); letter-spacing: -0.02em; text-decoration: none; }
  @media (max-width: 960px) {
    .links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 420px) { .resume { display: none; } }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const btn = document.getElementById('menu-btn')!;
  const sheet = document.getElementById('menu')!;
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    sheet.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(sheet.hidden));
  sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) { setOpen(false); btn.focus(); } });
  // theme toggle: the new theme spreads out from the button as a circle (View Transitions where supported)
  const themeBtn = document.getElementById('theme-btn')!;
  const root = document.documentElement;
  const label = () => themeBtn.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  label();
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem('fh-theme', next); } catch { /* not remembered */ }
      label();
      dispatchEvent(new CustomEvent('fh:theme', { detail: next }));
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    if (!doc.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
    const r = themeBtn.getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    doc.startViewTransition(apply).ready.then(() => {
      root.animate({ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] }, { duration: 700, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', pseudoElement: '::view-transition-new(root)' });
    });
  });

  // underline the section you are reading
  const spies = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const targets = spies.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        spies.forEach((a) => a.classList.toggle('on', a.dataset.spy === e.target.id));
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>
