---
import { SITE, STATS, ledger, toneOf, fmtDate, writeups, DIFFICULTY_ORDER } from '../data/site';
const picks = ledger();
const short = (s: string, max = 150) => {
  const first = s.split(/(?<=[.!?])\s/)[0];
  return first.length <= max ? first : first.slice(0, first.lastIndexOf(' ', max)) + '…';
};
// the real difficulty mix of the published writeups, easiest first
const mix = DIFFICULTY_ORDER.map((d) => ({ d, n: writeups.filter((w) => w.difficulty === d).length })).filter((m) => m.n > 0);
// a right-skewed curve of everyone on the platform, with the top 3% tail cut out
const W = 300, H = 120, cut = W * (1 - STATS.thmRank / 100);
const curveY = (x: number) => { const t = x / W; return H - 8 - (H - 22) * Math.pow(t / 0.22, 1.6) * Math.exp(1.6 * (1 - t / 0.22)) * 0.98; };
const pts = Array.from({ length: 61 }, (_, i) => { const x = (i / 60) * W; return [x, curveY(x)]; });
const curve = 'M ' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L ');
const tail = `M ${cut} ${H - 8} ` + pts.filter(([x]) => x >= cut).map(([x, y]) => `L ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ') + ` L ${W} ${H - 8} Z`;
const cutY = curveY(cut);
---
<section class="block record" id="record" aria-labelledby="record-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div><p class="label accent">The record</p><h2 id="record-title">Checkable, not claimed.</h2></div>
      <p>Certification, a public ranking and every lab written up in full: how I got in, the dead ends, and the fix. All of it can be checked.</p>
    </div>

    <div class="instruments" data-count>
      <figure class="inst rank" data-enter data-scout="rank">
        <svg class="curve" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <line class="axis" x1="0" y1={H - 8} x2={W} y2={H - 8} />
          <path class="tail" d={tail} />
          <path class="line" d={curve} />
          <line class="cut" x1={cut} y1={H - 8} x2={cut} y2={cutY - 18} />
          <circle class="me" cx={cut + 14} cy={curveY(cut + 14) - 1} r="4" />
          <text class="me-t" x={cut + 14} y={cutY - 26} text-anchor="middle">me</text>
          <text class="ax-t" x="0" y={H + 8}>everyone on TryHackMe</text>
        </svg>
        <figcaption>
          <p class="num">Top <span data-to={STATS.thmRank}>{STATS.thmRank}</span>%</p>
          <p class="what">TryHackMe global ranking. The red sliver is where I sit among everyone on the platform.</p>
          <a class="link-arrow" href={SITE.tryhackme} target="_blank" rel="noopener">View profile ↗</a>
        </figcaption>
      </figure>

      <figure class="inst rooms" data-enter data-scout="rooms">
        <div class="cells" aria-hidden="true">{Array.from({ length: STATS.rooms }, () => <i></i>)}</div>
        <figcaption>
          <p class="num"><span data-to={STATS.rooms}>{STATS.rooms}</span>+</p>
          <p class="what">Hands-on rooms completed across TryHackMe, Hack The Box and PortSwigger. One square each.</p>
        </figcaption>
      </figure>

      <figure class="inst mix" data-enter>
        <div class="mixwrap">
        <div class="bar" role="img" aria-label={mix.map((m) => `${m.n} ${m.d}`).join(', ')}>
          {mix.map((m) => <span style={`--tone:${toneOf(m.d)}; flex:${m.n}`}></span>)}
        </div>
        <ul class="legend">{mix.map((m) => <li style={`--tone:${toneOf(m.d)}`}><b>{m.n}</b> {m.d}</li>)}</ul>
        </div>
        <figcaption>
          <p class="num"><span data-to={STATS.writeups}>{STATS.writeups}</span></p>
          <p class="what">Published writeups, by difficulty. Every one is public, dead ends included.</p>
          <a class="link-arrow" href="/writeups/">Browse all ↗</a>
        </figcaption>
      </figure>
    </div>

    <div class="ledger-head">
      <h3 class="label">Selected writeups</h3>
      <p class="label stampline" aria-hidden="true">Declassified as you scroll</p>
    </div>
    <ol class="ledger" data-scout="ledger">
      {picks.map((w) => (
        <li>
          <a href={`/writeups/${w.slug}.html`} style={`--tone:${toneOf(w.difficulty)}`}>
            <span class="plat">{w.platform}</span>
            <span class="t"><span class="rd">{w.title}</span><small><span class="rd">{short(w.takeaway || w.summary)}</span></small></span>
            <span class="meta"><span class="lvl">{w.difficulty}</span><time datetime={w.date ?? undefined}>{fmtDate(w.date)}</time></span>
          </a>
        </li>
      ))}
    </ol>
    <a class="btn line more" href="/writeups/" data-reveal>All {STATS.writeups} writeups</a>
  </div>
</section>

<style>
  .instruments { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 96px; }
  .inst { display: flex; flex-direction: column; gap: 20px; padding: 24px; background: var(--card); border: 1px solid var(--rule); border-radius: 18px; }
  .inst > :first-child { height: 132px; }
  figcaption { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
  .num { font: 400 clamp(2.8rem, 5vw, 4.4rem)/1 var(--serif); letter-spacing: -0.04em; }
  .what { color: var(--soft); font-size: 14.5px; }
  .link-arrow { align-self: flex-start; font-size: 13.5px; margin-top: 4px; }

  .curve { width: 100%; overflow: visible; }
  .curve .axis { stroke: var(--rule-strong); stroke-width: 1; }
  .curve .line { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linejoin: round; }
  .curve .tail { fill: var(--accent); opacity: 0.85; }
  .curve .cut { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .curve .me { fill: var(--accent); }
  .curve text { font: 500 10px var(--mono); letter-spacing: 0.06em; fill: var(--muted); text-transform: uppercase; }
  .curve .me-t { fill: var(--accent); }

  .cells { align-self: stretch; display: grid; grid-template-columns: repeat(20, 1fr); gap: 3px; align-content: center; }
  .cells i { aspect-ratio: 1; border-radius: 2px; background: var(--ink); }
  .cells i:nth-child(7n + 3) { background: var(--soft); }
  .cells i:last-child { background: var(--accent); }

  .mixwrap { display: flex; flex-direction: column; justify-content: center; }
  .bar { display: flex; gap: 3px; height: 14px; }
  .bar span { background: var(--tone); border-radius: 3px; transform-origin: left; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 14px; font-size: 12.5px; color: var(--muted); }
  .legend li::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 2px; background: var(--tone); }
  .legend b { color: var(--ink); font-weight: 600; }

  .ledger-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .stampline { color: var(--muted); }
  .ledger { list-style: none; border-top: 1px solid var(--ink); }
  .ledger a { display: grid; grid-template-columns: 130px 1fr auto; gap: 24px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--rule); text-decoration: none; position: relative; }
  .ledger a::after { content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--tone); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .ledger a:hover::after { transform: scaleX(1); }
  .ledger a:hover .t { color: var(--tone-ink); }
  .plat { font: 500 11.5px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .t { font: 400 1.5rem/1.2 var(--serif); letter-spacing: -0.01em; transition: color 0.25s; }
  .t small { display: block; font: 400 15px/1.55 var(--sans); color: var(--muted); margin-top: 6px; max-width: 64ch; }
  .meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .lvl { font: 500 12px var(--mono); color: var(--tone-ink); border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent); padding: 3px 9px; border-radius: 999px; }
  time { font-size: 12.5px; color: var(--muted); }
  .more { margin-top: 36px; }

  /* redaction bars: they cover each line until the row scrolls in, then peel away */
  .rd { position: relative; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  :global(.js-motion) .ledger .rd { background: linear-gradient(var(--ink), var(--ink)) right / 100% 100% no-repeat; color: transparent; transition: background-size 0.7s var(--ease-out), color 0.2s 0.45s; }
  :global(.js-motion) .ledger small .rd { transition-delay: 0.12s, 0.55s; }
  :global(.js-motion) .ledger li.open .rd { background-size: 0% 100%; color: inherit; }

  @media (max-width: 960px) {
    .instruments { grid-template-columns: 1fr; }
    .inst { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 24px; }
    .inst > :first-child { height: auto; }
    .mix { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .inst { grid-template-columns: 1fr; }
    .ledger a { grid-template-columns: 1fr auto; gap: 8px 14px; }
    .plat { grid-column: 1 / -1; }
    .meta { grid-row: 2; grid-column: 2; }
    .stampline { display: none; }
  }
</style>

<script>
  import { animate, createDrawable, stagger, utils } from 'animejs';
  import { initReveals, countOnView, reduced } from '../scripts/motion';
  const root = document.getElementById('record')!;
  initReveals(root);
  countOnView(root);

  const once = (el: Element, fn: () => void, threshold = 0.35) => {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); fn(); } }, { threshold });
    io.observe(el);
  };

  // redacted rows peel open one by one as they enter
  const rows = [...root.querySelectorAll<HTMLLIElement>('.ledger li')];
  if (reduced) rows.forEach((li) => li.classList.add('open'));
  else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const i = rows.indexOf(e.target as HTMLLIElement);
      setTimeout(() => e.target.classList.add('open'), (i % 4) * 90);
    }), { rootMargin: '0px 0px -12% 0px' });
    rows.forEach((li) => io.observe(li));
  }

  if (!reduced) {
    const inst = root.querySelectorAll('.inst');
    once(root.querySelector('.instruments')!, () => {
      animate(inst, { opacity: [0, 1], y: [24, 0], duration: 800, delay: stagger(110), ease: 'outQuart' });

      // the curve draws, then the top tail fills in and the marker drops on
      const rank = root.querySelector('.rank')!;
      animate(createDrawable(rank.querySelector('.line')!), { draw: ['0 0', '0 1'], duration: 1300, delay: 150, ease: 'inOutQuad' });
      animate(rank.querySelector('.tail')!, { opacity: [0, 0.85], duration: 500, delay: 1350 });
      animate(createDrawable(rank.querySelector('.cut')!), { draw: ['0 0', '0 1'], duration: 400, delay: 1250 });
      animate(rank.querySelectorAll('.me, .me-t'), { opacity: [0, 1], duration: 500, delay: 1550 });

      // a hundred squares fill in, in no particular order
      const cells = utils.shuffle([...root.querySelectorAll<HTMLElement>('.cells i')]);
      animate(cells, { opacity: [0.08, 1], scale: [0.4, 1], duration: 380, delay: stagger(11, { start: 250 }), ease: 'outQuad' });

      animate(root.querySelectorAll('.bar span'), { scaleX: [0, 1], duration: 700, delay: stagger(140, { start: 400 }), ease: 'outExpo' });
    });
  }
</script>
