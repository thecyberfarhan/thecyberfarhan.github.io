---
import { PERSONAL_PROJECTS } from '../data/site';
// Secondary section: personal / niche projects, kept visually lighter than the
// main project grid so the security work stays the focus. Cards link out to GitHub.
// A tag filter appears only once there are enough projects to make it useful.
const projects = PERSONAL_PROJECTS;
const allTags = [...new Set(projects.flatMap((p) => p.tags))];
const showFilter = projects.length > 2;
---
{projects.length > 0 && (
  <section class="block personal" id="personal-projects" aria-labelledby="personal-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div>
          <p class="label">Personal projects</p>
          <h2 id="personal-title">Off the clock.</h2>
        </div>
        <p>Small tools I built to fix my own setup, outside security. Each one links to its repository and its full write-up on GitHub.</p>
      </div>

      {showFilter && (
        <div class="ptags" role="group" aria-label="Filter personal projects" data-reveal>
          <button type="button" data-ptag="all" aria-pressed="true">All</button>
          {allTags.map((t) => <button type="button" data-ptag={t} aria-pressed="false">{t}</button>)}
        </div>
      )}

      <ul class="plist" data-reveal="stagger">
        {projects.map((p) => (
          <li data-tags={p.tags.join(' ')}>
            <a class="pcard" href={p.href} target="_blank" rel="noopener">
              <span class="ptop">
                <span class="pstatus">{p.status}</span>
                <span class="pgo" aria-hidden="true">↗</span>
              </span>
              <h3>{p.name}</h3>
              <p>{p.tagline}</p>
              <ul class="ptaglist">{[p.language, ...p.tags].filter(Boolean).map((t) => <li>{t}</li>)}</ul>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* lighter than .projects: no case-folder, muted label, calmer cards */
  .personal .label { color: var(--muted); }
  .plist { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .plist > li[hidden] { display: none; }
  .pcard { display: flex; flex-direction: column; height: 100%; padding: 20px 22px 22px; text-decoration: none; background: var(--card); border: 1px solid var(--rule); border-radius: 12px; transition: border-color 0.25s, transform 0.3s var(--ease-out), box-shadow 0.4s; }
  .pcard:hover { border-color: color-mix(in srgb, var(--ink) 40%, var(--rule)); transform: translateY(-3px); box-shadow: 0 18px 30px -26px #0007; }
  .pcard:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .ptop { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .pstatus { font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .pgo { font-size: 17px; color: var(--muted); transition: transform 0.35s var(--ease-out), color 0.25s; }
  .pcard:hover .pgo { color: var(--ink); transform: translate(2px, -2px); }
  .pcard h3 { font-size: 1.4rem; margin-bottom: 8px; }
  .pcard > p { color: var(--soft); font-size: 14.5px; flex: 1; }
  .ptaglist { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .ptaglist li { font: 500 11px var(--mono); padding: 3px 8px; border-radius: 6px; background: var(--paper-2); color: var(--soft); }
  .ptags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .ptags button { padding: 7px 14px; border-radius: 999px; border: 1px solid var(--rule-strong); font-size: 13.5px; color: var(--soft); transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .ptags button:hover { border-color: var(--ink); color: var(--ink); }
  .ptags button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  @media (max-width: 980px) { .plist { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .plist { grid-template-columns: 1fr; } }
</style>

<script>
  import { initReveals } from '../scripts/motion';
  const root = document.getElementById('personal-projects');
  if (root) {
    initReveals(root);
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-ptag]')];
    const items = [...root.querySelectorAll<HTMLElement>('.plist > li')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.ptag!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((li) => { li.hidden = !(t === 'all' || (li.dataset.tags || '').split(' ').includes(t)); });
    }));
  }
</script>
