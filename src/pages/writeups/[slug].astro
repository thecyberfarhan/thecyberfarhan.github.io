---
import { keepCodeTogether } from '../../lib/inline-code';
import { highlightBlocks } from '../../lib/highlight';
import Base from '../../layouts/Base.astro';
import { writeups, toneOf, fmtDate, SITE, toolName, type Writeup } from '../../data/site';

export function getStaticPaths() {
  return writeups.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, newer: writeups[i - 1] ?? null, older: writeups[i + 1] ?? null },
  }));
}
interface Props { w: Writeup; newer: Writeup | null; older: Writeup | null }
const { w, newer, older } = Astro.props;

const tone = toneOf(w.difficulty);
const words = [w.tldrHtml, ...w.sections.map((s) => s.html), w.takeawayHtml, w.againHtml].join(' ').replace(/<[^>]+>/g, ' ').split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 220));
const path = `/writeups/${w.slug}.html`;
const sections = await Promise.all(w.sections.map(async (s) => ({ ...s, html: await highlightBlocks(keepCodeTogether(s.html)) })));
const againHtml = w.againHtml ? await highlightBlocks(keepCodeTogether(w.againHtml)) : '';
const description = w.summary;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${w.title}: ${w.platform} writeup`,
  description,
  datePublished: w.date ?? undefined,
  author: { '@type': 'Person', '@id': `${SITE.url}/#me`, name: SITE.name, url: `${SITE.url}/` },
  url: `${SITE.url}${path}`,
  mainEntityOfPage: `${SITE.url}${path}`,
  about: w.tools,
};
const toc = [
  ...(w.tldrHtml ? [{ id: 'tldr', label: 'TL;DR' }] : []),
  ...w.sections.map((s) => ({ id: s.id, label: s.label })),
  ...(w.takeawayHtml ? [{ id: 'takeaway', label: 'Key takeaway' }] : []),
  ...(w.againHtml ? [{ id: 'again', label: 'If I did it again' }] : []),
];
---
<Base title={`${w.title}: ${w.platform} writeup | Farhan Hussain`} description={description} path={path} type="article" jsonld={jsonld} tone={tone} ogImage={`/og/writeups/${w.slug}.jpg`}>
  <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  <article class="wrap doc">
    <header class="head" data-enter="kids">
      <a class="back label" href="/writeups/">← All writeups</a>
      <p class="label kicker">{w.platform} writeup</p>
      <h1 style={`view-transition-name: w-${w.slug}`}>{w.title}</h1>
      <ul class="meta">
        {w.difficulty && <li class="lvl">{w.difficulty}</li>}
        {w.date && <li><time datetime={w.date}>{fmtDate(w.date)}</time></li>}
        <li>{minutes} min read</li>
      </ul>
    </header>

    <div class="layout">
      <aside class="side">
        <nav class="toc" aria-label="On this page" data-scout="toc">
          <p class="label">On this page</p>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
        </nav>
        <div class="tools">
          <p class="label">Tools used</p>
          {w.tools.length > 0
            ? <ul>{w.tools.map((t) => <li>{toolName(t)}</li>)}</ul>
            : <p class="none">Not listed. Either it was all done by hand or the list is still in a terminal somewhere.</p>}
        </div>
      </aside>

      <div class="prose" id="prose">
        {w.tldrHtml
          ? <section id="tldr" class="tldr" data-scout="tldr"><p class="label">TL;DR</p><p set:html={keepCodeTogether(w.tldrHtml)} /></section>
          : <section class="missing"><p class="label">TL;DR · not found</p><p>No short version for this one. You will have to read the whole thing, like it is 2009.</p></section>}
        {w.sections.length === 0 && (
          <section class="missing broken">
            <p class="label">Writeup · failed to load</p>
            <p>The markdown for this writeup fought the parser and won. The original is still on GitHub, exactly as written.</p>
            <a class="link-arrow" href={w.github} target="_blank" rel="noopener">Read it on GitHub ↗</a>
          </section>
        )}
        {sections.map((s) => (
          <section id={s.id}>
            <h2>{s.label}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}
        {w.takeawayHtml
          ? <section id="takeaway" class="takeaway" data-scout="takeaway"><p class="label">Key takeaway</p><p set:html={keepCodeTogether(w.takeawayHtml)} /></section>
          : <section class="missing"><p class="label">Key takeaway · not written yet</p><p>The takeaway so far is that Farhan owes this page a takeaway. It is on the list.</p></section>}
        {w.againHtml && <section id="again"><h2>If I did it again</h2><Fragment set:html={againHtml} /></section>}

        <div class="end">
          <a class="btn solid" href={w.github} target="_blank" rel="noopener">Full writeup on GitHub ↗</a>
          <a class="btn line" href="/writeups/">All writeups</a>
        </div>
        <nav class="pn" aria-label="More writeups">
          {older ? <a href={`/writeups/${older.slug}.html`}><span class="label">← Older</span><span class="pt">{older.title}</span></a> : <span />}
          {newer ? <a class="nx" href={`/writeups/${newer.slug}.html`}><span class="label">Newer →</span><span class="pt">{newer.title}</span></a> : <span />}
        </nav>
      </div>
    </div>
  </article>
  <footer class="mini wrap">
    <span>Part of <a class="link-arrow" href="/">{SITE.name}</a>'s portfolio. Written in the <a class="link-arrow" href={SITE.writeupsRepo} target="_blank" rel="noopener">CTF-Writeups</a> repo and mirrored here.</span>
  </footer>
</Base>

<style>
  .missing { margin: 26px 0; padding: 20px 22px; border: 1.5px dashed var(--rule-strong); border-radius: 14px; color: var(--muted); }
  .missing .label { color: var(--muted); margin-bottom: 6px; }
  .missing p:last-child, .missing .link-arrow { margin: 0; }
  .missing.broken { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .missing.broken .label { color: var(--accent); }
  .tools .none { margin-top: 10px; font-size: 13.5px; color: var(--muted); }
  .progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 60; }
  .progress span { display: block; height: 100%; width: 100%; background: var(--tone); transform: scaleX(0); transform-origin: left; }
  .doc { padding-top: clamp(110px, 13vw, 150px); padding-bottom: clamp(80px, 10vw, 120px); }
  .back { text-decoration: none; display: inline-block; margin-bottom: 34px; }
  .back:hover { color: var(--accent); }
  .kicker { color: var(--tone-ink); }
  .head h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); line-height: 0.98; letter-spacing: -0.035em; margin: 14px 0 22px; overflow-wrap: anywhere; }
  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; font-size: 14px; color: var(--muted); padding-bottom: 30px; border-bottom: 1px solid var(--ink); }
  .meta .lvl { font: 500 12.5px var(--mono); color: var(--tone-ink); border: 1px solid color-mix(in srgb, var(--tone) 50%, transparent); padding: 4px 11px; border-radius: 999px; }
  .layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: clamp(30px, 5vw, 70px); margin-top: 44px; }
  .side { position: sticky; top: 96px; align-self: start; display: flex; flex-direction: column; gap: 34px; max-height: calc(100vh - 120px); overflow: hidden auto; overscroll-behavior: contain; scrollbar-width: none; padding-left: 2px; }
  .side::-webkit-scrollbar { display: none; }
  /* no visible scrollbar: the edge that still has more to show fades out instead */
  .side.more-down { mask-image: linear-gradient(#000 calc(100% - 56px), transparent); }
  .side.more-up { mask-image: linear-gradient(transparent, #000 56px); }
  .side.more-up.more-down { mask-image: linear-gradient(transparent, #000 56px, #000 calc(100% - 56px), transparent); }
  .toc ol { list-style: none; margin-top: 12px; border-left: 1px solid var(--rule); }
  .toc a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 14px; color: var(--muted); text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .toc a.on { color: var(--ink); border-color: var(--tone); }
  .tools ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .tools li { font: 500 11.5px var(--mono); padding: 4px 9px; border-radius: 6px; background: var(--paper-2); color: var(--soft); }

  .prose { max-width: 720px; font-size: 17px; line-height: 1.75; color: var(--soft); }
  .prose section { scroll-margin-top: 90px; }
  .prose section + section { margin-top: 54px; }
  .prose h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); color: var(--ink); margin-bottom: 18px; display: flex; align-items: baseline; gap: 12px; }
  .prose h2::before { content: ''; width: 18px; height: 2px; background: var(--tone); transform: translateY(-6px); flex: none; }
  .prose :global(h3) { font: 600 1.05rem var(--sans); color: var(--ink); margin: 32px 0 10px; letter-spacing: -0.005em; }
  .prose :global(p) { margin-bottom: 16px; }
  /* links written inside the writeup; the page's own buttons and cards keep their colours */
  .prose :global(a:not(.btn)) { color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--rule-strong); }
  .prose :global(a:hover) { text-decoration-color: var(--tone); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(code) { font: 500 0.86em var(--mono); background: var(--paper-2); color: var(--ink); padding: 2px 6px; border-radius: 5px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .prose :global(code.nw) { white-space: nowrap; }
  .prose :global(pre) { position: relative; margin: 0 0 22px; padding: 18px 18px; background: var(--code-bg); color: var(--code-fg); border-radius: 12px; overflow-x: auto; font: 13px/1.65 var(--mono); }
  .prose :global(pre code) { background: none; color: inherit; padding: 0; font-size: inherit; }
  .prose :global(.copy) { position: absolute; top: 8px; right: 8px; font: 500 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 10px; border-radius: 6px; background: #2c2f36; color: #c9c6bf; opacity: 0; transition: opacity 0.2s, background 0.2s; }
  .prose :global(pre:hover .copy), .prose :global(.copy:focus-visible) { opacity: 1; }
  .prose :global(.copy.done) { background: var(--ok); color: #fff; }
  @media (hover: none) {
    .prose :global(.copy) { opacity: 1; }
    .prose :global(pre) { padding-top: 42px; }
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin-bottom: 18px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(blockquote) { margin: 0 0 18px; padding: 4px 0 4px 18px; border-left: 2px solid var(--tone); color: var(--soft); font-style: italic; }
  .prose :global(.aside) { font-size: 15px; color: var(--muted); font-style: italic; }
  .prose :global(.table-wrap) { overflow-x: auto; margin: 0 0 24px; border: 1px solid var(--rule); border-radius: 10px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; background: var(--card); }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose :global(th) { font: 500 11.5px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: var(--paper-2); }
  .prose :global(tr:last-child td) { border-bottom: 0; }
  .prose :global(.sev-critical) { color: var(--accent); font-weight: 600; }
  .prose :global(.sev-high) { color: var(--warn); font-weight: 600; }
  .prose :global(.sev-medium) { color: var(--soft); font-weight: 600; }
  .tldr, .takeaway { padding: 22px 24px; border-radius: 14px; background: var(--card); border: 1px solid var(--rule); border-left: 3px solid var(--tone); color: var(--ink); }
  .tldr .label, .takeaway .label { color: var(--tone-ink); margin-bottom: 8px; }
  .tldr p:last-child, .takeaway p:last-child { margin: 0; }
  .takeaway { font: 400 1.25rem/1.5 var(--serif); }
  .end { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--rule); }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 30px; }
  .pn a { display: flex; flex-direction: column; gap: 6px; padding: 18px; border: 1px solid var(--rule); border-radius: 12px; text-decoration: none; background: var(--card); transition: border-color 0.2s; }
  .pn a:hover { border-color: var(--ink); }
  .pn .nx { text-align: right; }
  .pt { font: 400 1.2rem var(--serif); color: var(--ink); }
  .mini { padding-top: 70px; padding-bottom: 50px; font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; max-height: none; flex-direction: column-reverse; gap: 22px; padding: 18px; border: 1px solid var(--rule); border-radius: 14px; background: var(--card); }
    .toc ol { columns: 2; column-gap: 20px; }
    .pn { grid-template-columns: 1fr; }
    .pn .nx { text-align: left; }
  }
</style>

<script>
  import { animate, onScroll, stagger } from 'animejs';
  import { reduced } from '../../scripts/motion';
  import { initSidePanel } from '../../scripts/side-panel';

  // reading progress, scrubbed to the article
  const bar = document.getElementById('bar')!;
  const prose = document.getElementById('prose')!;
  animate(bar, { scaleX: [0, 1], ease: 'linear', autoplay: onScroll({ target: prose, enter: 'start start', leave: 'end end', sync: true }) });

  if (!reduced) {
    // arriving from another page of the site, the title morphs in through the view transition
    const morphed = 'onpagereveal' in window && document.referrer.startsWith(location.origin);
  if (morphed) document.querySelector<HTMLElement>('.head h1')!.style.opacity = '1';
    animate(morphed ? '.head > :not(h1)' : '.head > *', { opacity: [0, 1], y: [18, 0], duration: 800, delay: stagger(80), ease: 'outQuart' });
  }

  // copy buttons on every code block
  prose.querySelectorAll('pre').forEach((pre) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'copy';
    b.textContent = 'Copy';
    b.setAttribute('aria-label', 'Copy code');
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
        b.textContent = 'Copied';
        b.classList.add('done');
        setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1500);
      } catch { /* clipboard blocked */ }
    });
    pre.appendChild(b);
  });

  // highlight the section being read in the contents rail
  const follow = initSidePanel(document.querySelector<HTMLElement>('.side')!);
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.remove('on'));
      const on = links.get(e.target.id);
      on?.classList.add('on');
      follow(on);
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  prose.querySelectorAll('section[id]').forEach((s) => io.observe(s));

  // Easter egg: reading a pentest writeup on a phone gets a cookie-banner-style reaction, once
  const PHONE_KEY = 'fh-phone-egg';
  let seen = false;
  try { seen = !!localStorage.getItem(PHONE_KEY); } catch { /* storage blocked */ }
  if (!seen && matchMedia('(pointer: coarse)').matches && innerWidth < 760) {
    setTimeout(async () => {
      const [{ say }, { line }] = await Promise.all([import('../../scripts/scout'), import('../../scripts/lines')]);
      const done = () => { try { localStorage.setItem(PHONE_KEY, '1'); } catch { /* fine */ } };
      done();
      say(line('phoneAsk'), {
        state: 'surprised', stay: true,
        actions: [
          { label: 'Termux hacker', onClick: () => { done(); say(line('phoneTermux'), { state: 'proud', gesture: 'nod', ms: 5500 }); } },
          { label: 'Just curious', onClick: () => { done(); say(line('phoneCurious'), { state: 'playful', ms: 5000 }); } },
        ],
      });
    }, 2500);
  }
</script>
