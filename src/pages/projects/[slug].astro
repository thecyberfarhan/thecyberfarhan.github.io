---
import { keepCodeTogether } from '../../lib/inline-code';
import { highlightBlocks } from '../../lib/highlight';
import { changeCards, terminalFrames } from '../../lib/project-html';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { syncedProjects, SITE, type SyncedProject } from '../../data/site';

export function getStaticPaths() {
  return syncedProjects.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, newer: syncedProjects[i - 1] ?? null, older: syncedProjects[i + 1] ?? null },
  }));
}
interface Props { p: SyncedProject; newer: SyncedProject | null; older: SyncedProject | null }
const { p, newer, older } = Astro.props;

const TONE: Record<string, string> = { Original: '#3f6e8c', Fork: '#a8642a', 'Field note': '#24704d' };
const tone = TONE[p.kind] ?? TONE.Original;
const path = `/projects/${p.slug}.html`;
const description = p.tagline;
// each README section, coloured and reshaped for the page (fix cards, terminal frames)
const sections = await Promise.all(p.sections.map(async (s) => {
  let html = await highlightBlocks(keepCodeTogether(s.html));
  if (s.id === 'what-changed') html = changeCards(html);
  if (s.id === 'example-output') html = terminalFrames(html, p.name);
  return { ...s, html };
}));
// the numbers strip under the title, all read from the README or GitHub by the sync
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '')}k` : String(n));
const st = p.stats ?? { fixes: 0, additions: 0, tests: null };
const stats: { n: string; count?: number; label: string; href?: string; tone?: string }[] = [
  ...(st.fixes ? [{ n: String(st.fixes), count: st.fixes, label: st.fixes === 1 ? 'bug fixed' : 'bugs fixed' }] : []),
  ...(st.additions ? [{ n: String(st.additions), count: st.additions, label: st.additions === 1 ? 'addition' : 'additions' }] : []),
  ...(st.tests ? [{ n: String(st.tests), count: st.tests, label: 'automated tests' }] : []),
  ...(p.ci?.conclusion === 'success' ? [{ n: 'Passing', label: 'CI on GitHub', href: p.ci.url, tone: 'ok' }] : []),
  ...(p.upstreamStars ? [{ n: `${compact(p.upstreamStars)}★`, label: 'upstream stars' }] : []),
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${p.name}: ${p.kind.toLowerCase()}`,
  description,
  author: { '@type': 'Person', '@id': `${SITE.url}/#me`, name: SITE.name, url: `${SITE.url}/` },
  url: `${SITE.url}${path}`,
  mainEntityOfPage: `${SITE.url}${path}`,
  about: [p.language, p.skillArea].filter(Boolean),
};
const facts: [string, string][] = [
  ['Kind', p.kind],
  ['Status', p.status],
  ...(p.language ? [['Language', p.language] as [string, string]] : []),
  ...(p.requires ? [['Requires', p.requires] as [string, string]] : []),
  ...(p.license ? [['License', p.license] as [string, string]] : []),
  ...(p.upstream ? [['Upstream', p.upstream + (p.upstreamStars ? ` (${p.upstreamStars.toLocaleString()}★)` : '')] as [string, string]] : []),
  ...(p.scope ? [['Scope', p.scope] as [string, string]] : []),
  ['Skill area', p.skillArea],
];
const repoPath = p.href.replace('https://github.com/', '');
---
<Base title={`${p.name} | Farhan Hussain`} description={description} path={path} type="article" jsonld={jsonld} tone={tone} ogImage={`/og/projects/${p.slug}.png`}>
  <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  <article class="wrap doc">
    <header class="head" data-enter="kids">
      <a class="back label" href="/projects/">← All projects</a>
      <p class="label kicker">{p.kind}{p.stars ? ` · ${p.stars.toLocaleString()}★` : ''}</p>
      <h1 style={`view-transition-name: p-${p.slug}`}>{p.name}</h1>
      <p class="tagline">{p.tagline}</p>
      <ul class="meta">
        <li class="lvl">{p.status}</li>
        {p.pushedAt && <li>Updated <time datetime={p.pushedAt}>{p.pushedAt}</time></li>}
      </ul>
      {stats.length > 0 && (
        <ul class="stats" aria-label="In numbers">
          {stats.map((x) => {
            const Tag = x.href ? 'a' : 'div';
            return (
              <li>
                <Tag class:list={['stat', x.tone]} {...(x.href ? { href: x.href, target: '_blank', rel: 'noopener' } : {})}>
                  <b data-count={x.count}>{x.tone === 'ok' && <i class="pulse" aria-hidden="true"></i>}{x.n}</b>
                  <span>{x.label}{x.href && ' ↗'}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
      )}
    </header>

    <div class="layout">
      <aside class="side">
        <nav class="toc" aria-label="On this page" data-scout="toc">
          <p class="label">On this page</p>
          <ol>{p.sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ol>
        </nav>
        <div class="facts">
          <p class="label">At a glance</p>
          <dl>{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        </div>
        <a class="btn solid sm gh" href={p.href} target="_blank" rel="noopener" title={`${repoPath} on GitHub`}>View on GitHub ↗</a>
      </aside>

      <div class="prose" id="prose">
        {sections.map((s) => (
          <section id={s.id}>
            <h2>{s.label}</h2>
            <Fragment set:html={s.html} />
          </section>
        ))}

        <div class="end">
          <a class="btn solid" href={p.href} target="_blank" rel="noopener">Full source on GitHub ↗</a>
          <a class="btn line" href="/projects/">All projects</a>
        </div>
        <nav class="pn" aria-label="More projects">
          {older ? <a href={`/projects/${older.slug}.html`}><span class="label">← Older</span><span class="pt">{older.name}</span></a> : <span />}
          {newer ? <a class="nx" href={`/projects/${newer.slug}.html`}><span class="label">Newer →</span><span class="pt">{newer.name}</span></a> : <span />}
        </nav>
      </div>
    </div>
  </article>
  <Contact slot="after" />
</Base>

<style>
  .progress { position: fixed; inset: 0 0 auto; height: 3px; z-index: 60; }
  .progress span { display: block; height: 100%; width: 100%; background: var(--tone); transform: scaleX(0); transform-origin: left; }
  .doc { padding-top: clamp(110px, 13vw, 150px); padding-bottom: clamp(80px, 10vw, 120px); }
  .back { text-decoration: none; display: inline-block; margin-bottom: 34px; }
  .back:hover { color: var(--accent); }
  .kicker { color: var(--tone-ink); }
  .head h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); line-height: 0.98; letter-spacing: -0.035em; margin: 14px 0 16px; overflow-wrap: anywhere; }
  .tagline { color: var(--soft); font-size: clamp(1.05rem, 1.6vw, 1.25rem); max-width: 60ch; margin-bottom: 24px; }
  .head { padding-bottom: 30px; border-bottom: 1px solid var(--ink); }
  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; font-size: 14px; color: var(--muted); }
  .meta .lvl { font: 500 12.5px var(--mono); color: var(--tone-ink); border: 1px solid color-mix(in srgb, var(--tone) 50%, transparent); padding: 4px 11px; border-radius: 999px; }
  .layout { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: clamp(30px, 5vw, 70px); margin-top: 44px; }
  .side { position: sticky; top: 96px; align-self: start; display: flex; flex-direction: column; gap: 28px; max-height: calc(100vh - 120px); overflow: hidden auto; overscroll-behavior: contain; scrollbar-width: none; padding-left: 2px; }
  .side::-webkit-scrollbar { display: none; }
  /* no visible scrollbar: the edge that still has more to show fades out instead */
  .side.more-down { mask-image: linear-gradient(#000 calc(100% - 56px), transparent); }
  .side.more-up { mask-image: linear-gradient(transparent, #000 56px); }
  .side.more-up.more-down { mask-image: linear-gradient(transparent, #000 56px, #000 calc(100% - 56px), transparent); }
  .toc ol { list-style: none; margin-top: 12px; border-left: 1px solid var(--rule); }
  .toc a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 14px; color: var(--muted); text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .toc a.on { color: var(--ink); border-color: var(--tone); }
  .facts dl { margin-top: 10px; display: flex; flex-direction: column; gap: 10px; }
  .facts div { display: flex; flex-direction: column; gap: 2px; }
  .facts dt { font: 500 10.5px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .facts dd { font-size: 14px; color: var(--ink); overflow-wrap: anywhere; }
  .gh { font-size: 13px; justify-content: center; text-align: center; }

  .prose { max-width: 720px; font-size: 17px; line-height: 1.75; color: var(--soft); }
  .prose section { scroll-margin-top: 90px; }
  .prose section + section { margin-top: 54px; }
  .prose h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); color: var(--ink); margin-bottom: 18px; display: flex; align-items: baseline; gap: 12px; }
  .prose h2::before { content: ''; width: 18px; height: 2px; background: var(--tone); transform: translateY(-6px); flex: none; }
  .prose :global(h3) { font: 600 1.05rem var(--sans); color: var(--ink); margin: 32px 0 10px; letter-spacing: -0.005em; }
  .prose :global(p) { margin-bottom: 16px; }
  .prose :global(a:not(.btn)) { color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--rule-strong); }
  .prose :global(a:hover) { text-decoration-color: var(--tone); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(code) { font: 500 0.86em var(--mono); background: var(--paper-2); color: var(--ink); padding: 2px 6px; border-radius: 5px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .prose :global(code.nw) { white-space: nowrap; }
  .prose :global(pre) { position: relative; margin: 0 0 22px; padding: 18px 18px; background: var(--code-bg); color: var(--code-fg); border-radius: 12px; overflow-x: auto; font: 13px/1.65 var(--mono); }
  .prose :global(pre code) { background: none; color: inherit; padding: 0; font-size: inherit; }
  .prose :global(.copy) { position: absolute; top: 8px; right: 8px; font: 500 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 10px; border-radius: 6px; background: #2c2f36; color: #c9c6bf; opacity: 0; transition: opacity 0.2s, background 0.2s; }
  .prose :global(pre:hover .copy), .prose :global(.copy:focus-visible) { opacity: 1; }
  .prose :global(.copy.done) { background: var(--ok); color: #fff; }
  @media (hover: none) {
    .prose :global(.copy) { opacity: 1; }
    .prose :global(pre) { padding-top: 42px; }
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin-bottom: 18px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(blockquote) { margin: 0 0 18px; padding: 4px 0 4px 18px; border-left: 2px solid var(--tone); color: var(--soft); font-style: italic; }
  .prose :global(.table-wrap) { overflow-x: auto; margin: 0 0 24px; border: 1px solid var(--rule); border-radius: 10px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 14.5px; background: var(--card); }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose :global(th) { font: 500 11.5px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: var(--paper-2); }
  .prose :global(tr:last-child td) { border-bottom: 0; }

  .end { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--rule); }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 30px; }
  .pn a { display: flex; flex-direction: column; gap: 6px; padding: 18px; border: 1px solid var(--rule); border-radius: 12px; text-decoration: none; background: var(--card); transition: border-color 0.2s; }
  .pn a:hover { border-color: var(--ink); }
  .pn .nx { text-align: right; }
  .pt { font: 400 1.2rem var(--serif); color: var(--ink); }

  /* numbers strip under the title */
  .stats { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .stat { display: flex; flex-direction: column; gap: 2px; min-width: 118px; padding: 12px 16px 13px; border: 1px solid var(--rule); border-radius: 12px; background: var(--card); text-decoration: none; transition: border-color 0.2s, transform 0.3s var(--ease-out); }
  a.stat:hover { border-color: var(--ok); transform: translateY(-2px); }
  .stat b { display: flex; align-items: center; gap: 8px; font: 400 1.75rem/1.1 var(--serif); color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat span { font: 500 10.5px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .stat.ok b { color: var(--ok); }
  .pulse { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--ok); flex: none; }
  .pulse::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--ok); animation: pulse 2s ease-out infinite; }
  @keyframes pulse { from { transform: scale(1); opacity: 0.6; } to { transform: scale(2.8); opacity: 0; } }

  /* "What changed" as numbered cards */
  .prose :global(.fixes) { display: grid; gap: 14px; counter-reset: fix; }
  .prose :global(.fix) { --k: var(--tone); position: relative; padding: 18px 20px 6px 22px; border: 1px solid var(--rule); border-radius: 14px; background: var(--card); overflow: hidden; }
  .prose :global(.fix::before) { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--k); }
  .prose :global(.fix[data-kind='fixed']) { --k: var(--accent); }
  .prose :global(.fix[data-kind='added']) { --k: var(--ok); }
  .prose :global(.fix[data-kind='housekeeping']), .prose :global(.fix[data-kind='modernised']) { --k: var(--rule-strong); }
  .prose :global(.fix-h) { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .prose :global(.fix-n) { font: 500 12px var(--mono); color: var(--muted); }
  .prose :global(.fix-tag) { font: 500 10.5px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--k); border: 1px solid color-mix(in srgb, var(--k) 45%, transparent); padding: 2px 8px; border-radius: 999px; }
  .prose :global(.fix h3) { margin: 0 0 8px; font-size: 1.08rem; line-height: 1.4; }
  .prose :global(.fix-b) { font-size: 15.5px; line-height: 1.7; }

  /* "Example output" as a terminal window that replays the run */
  .prose :global(.term) { margin: 0 0 22px; border-radius: 12px; overflow: hidden; background: var(--code-bg); box-shadow: 0 0 0 1px #ffffff10, var(--shadow); }
  .prose :global(.term-bar) { display: flex; align-items: center; gap: 12px; padding: 9px 12px; background: #1d2027; border-bottom: 1px solid #ffffff12; font: 500 11.5px var(--mono); color: #9aa0a9; }
  .prose :global(.dots) { display: flex; gap: 6px; }
  .prose :global(.dots i) { width: 10px; height: 10px; border-radius: 50%; background: #3a3f48; }
  .prose :global(.dots i:nth-child(1)) { background: #ff5f57; }
  .prose :global(.dots i:nth-child(2)) { background: #febc2e; }
  .prose :global(.dots i:nth-child(3)) { background: #28c840; }
  .prose :global(.term-t) { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .prose :global(.term-copy), .prose :global(.term-replay) { font: 500 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 6px; background: #2c2f36; color: #c9c6bf; transition: background 0.2s; }
  .prose :global(.term-copy:hover), .prose :global(.term-replay:hover) { background: #3a3e47; }
  .prose :global(.term-copy.done) { background: var(--ok); color: #fff; }
  .prose :global(.term pre) { margin: 0; border-radius: 0; }
  .prose :global(.term .line) { display: inline-block; }
  .prose :global(.term .line.wait) { visibility: hidden; }
  .prose :global(.caret) { display: inline-block; width: 0.6em; height: 1.1em; margin-left: 2px; vertical-align: -0.2em; background: var(--code-fg); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* upstream vs this fork switch above the comparison table */
  .prose :global(.cmp-switch) { display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 12px; border: 1px solid var(--rule); border-radius: 999px; background: var(--card); }
  .prose :global(.cmp-switch button) { padding: 6px 14px; border-radius: 999px; font: 500 12.5px var(--sans); color: var(--muted); transition: background 0.25s, color 0.25s; }
  .prose :global(.cmp-switch button[aria-pressed='true']) { background: var(--ink); color: var(--paper); }
  .prose :global(.cmp td), .prose :global(.cmp th) { transition: opacity 0.3s, background-color 0.3s; }
  .prose :global(.cmp[data-show='fork'] tr > :nth-child(2)), .prose :global(.cmp[data-show='upstream'] tr > :nth-child(3)) { opacity: 0.45; }
  .prose :global(.cmp[data-show='fork'] td:nth-child(3)), .prose :global(.cmp[data-show='upstream'] td:nth-child(2)) { background: color-mix(in srgb, var(--tone) 9%, var(--card)); color: var(--ink); }
  @media (max-width: 640px) {
    .prose :global(.cmp[data-show='fork'] tr > :nth-child(2)), .prose :global(.cmp[data-show='upstream'] tr > :nth-child(3)) { display: none; }
  }
  @media (max-width: 640px) { .stats { display: grid; grid-template-columns: 1fr 1fr; } .stat { min-width: 0; } }
  @media (prefers-reduced-motion: reduce) { .pulse::after, .prose :global(.caret) { animation: none; } }
  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; max-height: none; flex-direction: column-reverse; gap: 22px; padding: 18px; border: 1px solid var(--rule); border-radius: 14px; background: var(--card); }
    .toc ol { columns: 2; column-gap: 20px; }
    .pn { grid-template-columns: 1fr; }
    .pn .nx { text-align: left; }
  }
</style>

<script>
  import { animate, onScroll, stagger } from 'animejs';
  import { reduced } from '../../scripts/motion';
  import { initSidePanel } from '../../scripts/side-panel';

  const bar = document.getElementById('bar')!;
  const prose = document.getElementById('prose')!;
  animate(bar, { scaleX: [0, 1], ease: 'linear', autoplay: onScroll({ target: prose, enter: 'start start', leave: 'end end', sync: true }) });

  // arriving from another page of the site, the title morphs into place through the view
  // transition; animating it here as well would fight that, so only the rest of the header moves
  const morphed = 'onpagereveal' in window && document.referrer.startsWith(location.origin);
  if (morphed) document.querySelector<HTMLElement>('.head h1')!.style.opacity = '1';
  if (!reduced) {
    animate(morphed ? '.head > :not(h1)' : '.head > *', { opacity: [0, 1], y: [18, 0], duration: 800, delay: stagger(80), ease: 'outQuart' });
    // the numbers count up from zero
    document.querySelectorAll<HTMLElement>('.stat b[data-count]').forEach((b, i) => {
      const n = Number(b.dataset.count);
      const o = { v: 0 };
      b.lastChild!.textContent = '0';
      animate(o, { v: n, duration: 1100, delay: 450 + i * 90, ease: 'outExpo', modifier: Math.round, onUpdate: () => { b.lastChild!.textContent = String(o.v); } });
    });
  }

  const once = (els: Element[], fn: (el: Element) => void, rootMargin = '0px 0px -12% 0px') => {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); fn(e.target); } }), { rootMargin });
    els.forEach((el) => io.observe(el));
  };

  // "What changed" cards rise in one after another as they come into view
  const cards = [...prose.querySelectorAll('.fix')];
  if (!reduced && cards.length) {
    cards.forEach((c) => ((c as HTMLElement).style.opacity = '0'));
    once(cards, (c) => animate(c, { opacity: [0, 1], y: [26, 0], duration: 700, delay: (cards.indexOf(c) % 3) * 90, ease: 'outQuart' }));
  }

  // "Example output" replays like a live terminal the first time it scrolls into view: a "$ "
  // line types itself out, every other line prints in turn, and a caret blinks at the end
  function replay(term: HTMLElement) {
    const lines = [...term.querySelectorAll<HTMLElement>('.line')];
    term.querySelector('.caret')?.remove();
    lines.forEach((l) => l.classList.add('wait'));
    const gap = Math.max(25, Math.min(110, 2400 / Math.max(lines.length, 1)));
    let t = 0;
    lines.forEach((l) => {
      const typed = /^\$\s/.test(l.textContent ?? '');
      const at = t;
      setTimeout(() => {
        l.classList.remove('wait');
        if (typed) animate(l, { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'], duration: Math.min(1400, (l.textContent?.length ?? 10) * 38), ease: 'linear' });
      }, at);
      t += typed ? Math.min(1400, (l.textContent?.length ?? 10) * 38) + 260 : gap;
    });
    setTimeout(() => {
      const caret = document.createElement('span');
      caret.className = 'caret';
      caret.setAttribute('aria-hidden', 'true');
      (lines.at(-1) ?? term.querySelector('code'))?.after(caret);
      const btn = term.querySelector<HTMLButtonElement>('.term-replay');
      if (btn) btn.hidden = false;
    }, t);
  }
  const terms = [...prose.querySelectorAll<HTMLElement>('.term')];
  if (!reduced) {
    terms.forEach((term) => {
      term.querySelectorAll('.line').forEach((l) => l.classList.add('wait'));
      term.querySelector('.term-replay')?.addEventListener('click', () => replay(term));
    });
    once(terms, (term) => replay(term as HTMLElement), '0px 0px -25% 0px');
  }

  // Comparison on a fork: a switch picks which column to look at. The other column dims on a
  // wide screen and hides on a phone, where a three-column table doesn't fit
  const table = prose.querySelector<HTMLTableElement>('#comparison table');
  const heads = table ? [...table.querySelectorAll('thead th')] : [];
  if (table && heads.length === 3 && /upstream/i.test(heads[1].textContent ?? '')) {
    table.classList.add('cmp');
    table.dataset.show = 'fork';
    const sw = document.createElement('div');
    sw.className = 'cmp-switch';
    sw.setAttribute('role', 'group');
    sw.setAttribute('aria-label', 'Compare');
    const opts: [string, string][] = [['upstream', 'Upstream'], ['fork', 'This fork']];
    const buttons = opts.map(([v, label]) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.setAttribute('aria-pressed', String(v === 'fork'));
      b.addEventListener('click', () => {
        if (table.dataset.show === v) return;
        table.dataset.show = v;
        buttons.forEach((x, i) => x.setAttribute('aria-pressed', String(opts[i][0] === v)));
        if (!reduced) animate(table.querySelectorAll(`td:nth-child(${v === 'fork' ? 3 : 2})`), { opacity: [0.2, 1], x: [v === 'fork' ? 12 : -12, 0], duration: 450, delay: stagger(40), ease: 'outQuart' });
      });
      return b;
    });
    sw.append(...buttons);
    table.closest('.table-wrap')?.before(sw);
  }

  prose.querySelectorAll<HTMLElement>('pre').forEach((pre) => {
    if (pre.closest('.term')) { pre.closest('.term')!.querySelector('.term-bar')!.append(copyButton(pre, 'term-copy')); return; }
    pre.appendChild(copyButton(pre, 'copy'));
  });
  function copyButton(pre: HTMLElement, cls: string) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = cls;
    b.textContent = 'Copy';
    b.setAttribute('aria-label', 'Copy code');
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
        b.textContent = 'Copied';
        b.classList.add('done');
        setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1500);
      } catch { /* clipboard blocked */ }
    });
    return b;
  }

  const follow = initSidePanel(document.querySelector<HTMLElement>('.side')!);
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.remove('on'));
      const on = links.get(e.target.id);
      on?.classList.add('on');
      follow(on);
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  prose.querySelectorAll('section[id]').forEach((s) => io.observe(s));
</script>
